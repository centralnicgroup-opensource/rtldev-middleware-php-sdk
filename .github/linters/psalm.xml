<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
>
    <projectFiles>
        <directory name="../../src" />
        <directory name="../../tests" />
        <ignoreFiles>
            <directory name="../../vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- The LessSpecificReturnStatement suppression for src/ that stood here
             is gone: it existed because a `final` leaf in the client chain (the
             empty IBS/MONIKER SessionClients) made Psalm resolve `static` in the
             inherited fluent setters narrowly. Those classes were deleted in
             RSRMID-2920 and the brand clients are deliberately non-final, so the
             false positive has no source left. findUnusedBaselineEntry proved it
             dead rather than us assuming. -->
        <!-- PHPUnit invokes test classes/methods via reflection; findUnusedCode
             cannot see this usage, so its dead-code reports are false positives
             in tests/. Suppress that family for tests/ only; src/ stays strict. -->
        <UnusedClass>
            <errorLevel type="suppress">
                <directory name="../../tests" />
            </errorLevel>
        </UnusedClass>
        <!-- The @internal symbols added in RSRMID-2938 (CommandRedactor, the two
             brand SensitiveFields holders) are internal to the *package*, and the
             package's own tests are entitled to reach them — a redaction helper
             marked @internal precisely so no consumer calls it still has to be
             directly testable, which is half the reason it was extracted. Psalm
             scopes @internal to the declaring root namespace (CNIC), and the test
             namespace is CNICTEST, so every test reference raises these two. The
             suppression is scoped to tests/ only: src/ stays strict, so a genuine
             cross-namespace leak inside the SDK is still an error. Preferred over
             a `@psalm-internal CNICTEST` line in src/, which would make shipped
             production docblocks name the test namespace. -->
        <InternalClass>
            <errorLevel type="suppress">
                <directory name="../../tests" />
            </errorLevel>
        </InternalClass>
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="../../tests" />
            </errorLevel>
        </InternalMethod>
        <!-- The UnusedMethodCall suppression for tests/ is gone for the same
             reason: its only trigger was `ReflectionMethod::setAccessible()`,
             whose return value is discarded, in the two IDN tests that reached
             past the client to get at the CNR command-rewrite rules. RSRMID-2922
             gave those rules a public surface, so those calls are gone; the
             reflection that remains in tests/ reads its return values and cannot
             raise this. Psalm's own UnusedIssueHandlerSuppression reported the
             entry dead rather than us assuming. -->
    </issueHandlers>
</psalm>
