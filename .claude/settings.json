{
  "permissions": {
    "allow": [
      "Bash(composer test)",
      "Bash(composer test *)",
      "Bash(composer lint)",
      "Bash(composer lint *)",
      "Bash(composer codefix)",
      "Bash(composer phpstan)",
      "Bash(composer show *)",
      "Bash(composer install)",
      "Bash(composer phpcs)",
      "Bash(composer psalm)",
      "Bash(composer rector)",
      "Bash(composer rector:fix)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh repo view *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --list)",
      "Bash(git branch --show-current)",
      "Bash(git show *)",
      "Bash(git stash list *)"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "30000",
    "MAX_MCP_OUTPUT_TOKENS": "25000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tool-output-hygiene.sh\"",
            "timeout": 5,
            "statusMessage": "Checking tool-output hygiene"
          },
          {
            "type": "command",
            "command": "command -v rtk >/dev/null 2>&1 && exec rtk hook claude || exit 0",
            "statusMessage": "Optimizing command output (RTK)"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  }
}
