{
  // Everything shared with the other RTLDEV middleware repositories lives in the
  // devbase Feature, not here. What stays in this file is what a Feature cannot
  // set — the name, the workspace paths, the remote user, initializeCommand and
  // the host mounts — plus what is genuinely specific to *this* repository: the
  // PHP runtime, the PHP editor tooling, and the PHP ini provisioning.
  //
  // Feature options and troubleshooting:
  // https://github.com/centralnicgroup-opensource/rtldev-middleware-devcontainer-features
  "name": "dstack-phpsdk",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },

  // localWorkspaceFolderBasename is the repository directory name, so these two
  // cannot drift apart from it or from each other. Resolves to the same
  // /usr/share/rtldev-middleware-php-sdk as before.
  "workspaceMount": "source=${localWorkspaceFolder},target=/usr/share/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/usr/share/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopContainer",

  // Host-side preflight for the binds at the bottom of this file: Docker creates
  // a missing bind source itself, as a root-owned *directory*. For ~/.ssh and
  // ~/.claude that yields a directory nobody in the container can write to; for
  // ~/.gitconfig and ~/.zsh_history it yields a directory where a file is expected,
  // on the host too, where the damage outlives the container.
  // Creating them first is idempotent and cheap. Runs on the host, so it cannot
  // move into a Feature.
  "initializeCommand": {
    "claude-state": "mkdir -p ${localEnv:HOME}/.claude",
    "ssh-dir": "mkdir -p ${localEnv:HOME}/.ssh",
    "gitconfig": "touch ${localEnv:HOME}/.gitconfig",
    "zsh-history": "touch ${localEnv:HOME}/.zsh_history"
  },

  "features": {
    // The language this repository is written in stays with the repository.
    "ghcr.io/devcontainers/features/php:1": {
      "version": "8.3",
      "installComposer": true,
      "extensions": "xdebug"
    },

    // The shared behaviour layer: zsh with the team prompt, commitizen, pnpm,
    // the gh credential helper, persistent shell history, dependency
    // installation, the on-attach toolchain banner, and the RTK binary the
    // committed ~/.claude/settings.json hook looks for.
    //
    // It declares Node LTS and the GitHub CLI as its own dependencies, so neither
    // is listed here and their digests move with a devbase release instead of a
    // per-repository Dependabot PR. The Claude Code CLI was a third until devbase
    // 2.0.0 dropped it — the VS Code extension runs its own bundled runtime
    // (RSRMID-3053). Do NOT
    // re-declare node:2 to change its version: one Feature id with two option
    // sets counts as two Features under the spec's equality rule, so Node would
    // install twice into the same nvm path.
    "ghcr.io/centralnicgroup-opensource/rtldev-middleware-devcontainer-features/devbase:2": {}
  },

  "customizations": {
    "vscode": {
      // PHP tooling only. devbase contributes the shared layer — GitHub Actions,
      // GitHub PRs, Remote Containers, Containers, both Claude extensions,
      // shellcheck / shell-format / vscode-yaml — plus the zsh terminal profile
      // and the shellcheck/npm settings that go with them.
      "extensions": [
        "devsense.phptools-vscode",
        "xdebug.php-debug",
        "neilbrayfield.php-docblocker",
        "SanderRonde.phpstan-vscode",
        "ms-vscode.live-server"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/local/php/current/bin/php",
        "php.executablePath": "/usr/local/php/current/bin/php",
        "php.suggest.basic": false,
        "phpunit.config": ".github/phpunit.xml",
        // Absolute rather than ${containerWorkspaceFolder}: PHP Tools spawns
        // this without a shell, and an unresolved variable here fails at test
        // time. A repository rename means editing this one line — which fails
        // loudly (no such file) rather than silently skipping env.sh.
        "phpunit.command": "zsh /usr/share/rtldev-middleware-php-sdk/.devcontainer/supporting_files/scripts/phpunit-wrapper.sh \"${php}\" ${phpargs} -d xdebug.mode=coverage \"${phpunit}\" ${phpunitargs}",
        "php.problems.exclude": {
          "**/vendor/**": true,
          "**/node_modules/**": true
        }
      }
    }
  },

  "remoteUser": "vscode",

  // .ssh and .gitconfig make git work as it does on the host, both readonly: the
  // container reads that identity, it does not maintain it. devbase writes its
  // credential and signing config with `git config --local`, never `--global`,
  // exactly so the host's file stays untouched, so readonly costs nothing here.
  // /WSL_USER/.zsh_history is the single file devbase's history persistence
  // reads; .claude carries the Claude Code session
  // state including the RTK hook. Kept here because a Feature cannot mount.
  //
  // The history entry binds that one file and never the host home. Mounting
  // ${localEnv:HOME} at /WSL_USER to reach a single file inside it handed the
  // container read-write reach over the host's SSH keys, credentials and every
  // other repository on the machine — and in the workspace repository it made the
  // readonly flag on the GitHub tokens decorative, since the same inodes were
  // writable by that second path. (RSRMID-3052)
  //
  // Narrowing it also retired the ${localEnv:HOME}${localEnv:USERPROFILE}
  // concatenation, which resolved to neither path on a host defining both and left
  // Docker mounting an empty directory. A single-file bind needs the host file to
  // exist first instead — see the touch in initializeCommand above.
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.zsh_history,target=/WSL_USER/.zsh_history,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ],

  // onCreateCommand, NOT postCreateCommand -- this is load-bearing.
  //
  // centralnic-reseller/idn-converter requires ext-intl, which this repository
  // only has once the script has copied intl.ini into PHP's scan directory.
  // devbase installs project dependencies from its own postCreateCommand, and a
  // Feature's hooks run before the consuming devcontainer.json's hooks of the
  // same phase -- so running this at postCreateCommand puts it after composer,
  // which then fails with "your lock file does not contain a compatible set of
  // packages". onCreateCommand is the first create-phase command, so it lands
  // ahead of every postCreateCommand. It also gets xdebug.mode=coverage in place
  // before composer runs, instead of composer stalling on step-debug connects.
  //
  // No postAttachCommand: devbase supplies the banner and the env.sh autoload.
  "onCreateCommand": "zsh .devcontainer/supporting_files/scripts/apply-php-config.sh"
}
