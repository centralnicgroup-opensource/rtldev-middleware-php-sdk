    #requestUrl : string
    +__construct(raw, cmd, placeholders, context, parser, error)
    {abstract} #translate(raw, cmd, placeholders, error)
    {abstract} #populate(raw, parser, cmd)
    {abstract} #newResponseParser()
    {abstract} #newRecord(row)
    #sanitizeCommand(cmd)
    #assembleRecords()
    +getContext()
    +getRequestURL()
    +getPlain()
    +getHash()
    #registerColumn(col)
    #addRecord(row)
    +getColumn(columnName)
    +getColumnIndex(columnName, recordIndex)
    +getColumnKeys(filterPaginationKeys)
    +getColumns()
    +getCommand()
    +getCommandPlain()
    +getNextPageNumber()
    +getNumberOfPages()
    +getPagination()
    +getPreviousPageNumber()
    +getRecord(recordIndex)
    +getRecords()
    +getRecordsCount()
    +getIterator()
    #getHashString(key, default)
    #getHashArray(key)
  }
