    +__construct()
    +setLogin(login)
    +getLogin()
    +setPassword(password)
    +getURL()
    +setURL(url)
    +getOTEUrl()
    +getLiveUrl()
    +getSystem()
    +isOTE()
    +useOTESystem()
    +useLIVESystem()
    +useHighPerformanceConnectionSetup()
    +usesHighPerformanceConnectionSetup()
    {static} -toLoopback(url)
    +setProxy(proxy)
    +getProxy()
    +setReferer(referer)
    +getReferer()
    #getDefaultCurlOpts()
    +setExtraCurlOptions(opts)
    +resetCurlOptions()
    +getCurlOptions()
    {static} -rejectManagedOptions(opts)
    +getSocketTimeout()
    +setSocketTimeout(timeoutSeconds)
    #maskSensitiveCommand(command)
    {abstract} #getPOSTDataParams(command, maskSecrets)
    +getPOSTData(command, maskSecrets)
  }
  interface "TransportInterface\n<b>Contract for the low-level HTTP transport used by {</b>" as TransportInterface {
    +post(url, data, timeoutSeconds, userAgent, options)
    +close()
  }
  class "AbstractClient\n<b>Shared foundation for all registrar API clients.</b>" as AbstractClient {
    #context : array<string, mixed>
    #socketConfig : AbstractSocketConfig
    #debugMode : bool
    #userAgent : string
    #logger : LoggerInterface
    #transport : TransportInterface
    +__construct()
    +getSocketConfig()
    {abstract} +request(cmd, path)
    #performRequest(cmd, path)
    {abstract} #buildCommand(cmd)
    {abstract} #newResponse(raw, cmd, cfg, error)
    {abstract} #newSocketConfig()
    #newTransport()
    +setTransport(transport)
    +getTransport()
    {abstract} #newLogger(sink)
    +setLogSink(sink)
    +setCustomLogger(customLogger)
    +getLogger()
    +enableDebugMode()
    +disableDebugMode()
    +getPOSTData(cmd, maskSecrets)
    +getURL()
    +setSocketTimeout(timeoutSeconds)
    +getSocketTimeout()
    +setUserAgent(label, revision, modules)
    +getUserAgent()
    +setExtraCurlOptions(opts)
    +resetCurlOptions()
    +setProxy(proxy)
    +getProxy()
    +setReferer(referer)
    +getReferer()
    +getVersion()
    +setURL(url)
    +setCredentials(login, password)
    +useHighPerformanceConnectionSetup()
    +IDNConvert(domains)
    #executeCurl(postData, cfg)
    +close()
    +getLiveUrl()
    +getSystem()
    +isOTE()
    +useOTESystem()
    +useLIVESystem()
    +setContext(context)
  }
  class "CommandRedactor\n<b>CommandRedactor</b>" as CommandRedactor {
