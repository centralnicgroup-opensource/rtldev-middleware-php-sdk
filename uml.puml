    {static} {abstract} +generateTemplate(code, description)
    {static} {abstract} +getTemplate(templateId)
    {static} {abstract} #createResponse(raw)
    {static} {abstract} #newResponseParser()
    {static} {abstract} #matchKeys()
    {static} +addTemplate(templateId, plain, description)
    {static} +resetTemplates()
    {static} +getTemplates()
    {static} +hasTemplate(templateId)
    {static} +isTemplateMatchHash(responseHash, templateId)
    {static} +isTemplateMatchPlain(plain, templateId)
    {static} -matches(templateHash, responseHash)
  }
