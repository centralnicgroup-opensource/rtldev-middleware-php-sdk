  class "EchoSink\n<b>Log sink writing to standard output — the shipped default, and what keeps</b>" as EchoSink {
    +write(message)
  }
  class "AbstractSocketConfig\n<b>Shared base for all registrar SocketConfig implementations, and **the one home</b>" as AbstractSocketConfig {
    #login : string
    #password : string
    #oteUrl : string
    #liveUrl : string
    #url : string
    #highPerformance : bool
    #proxy : ?string
    #referer : ?string
